# Copiá este archivo como .env y ajustá los valores:
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows CMD)
#
# IMPORTANTE: el archivo .env NO se sube a GitHub.

# Clave secreta de Django. Generá una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria

# True solo en desarrollo. En un sitio publicado debe ser False.
DEBUG=True

# Hosts permitidos, separados por coma.
ALLOWED_HOSTS=127.0.0.1,localhost
